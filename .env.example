# Copy to .env (local Vite dev) and/or .dev.vars (wrangler dev) and fill in real values.
# Never commit real credentials.
NESSIE_API_KEY=private
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
GEMINI_API_KEY=private
GEMINI_MODEL=gemini-3.8-flash
LLM=gemini
# Private server-only Mapbox public token for ATM map previews. The card loads
# `/api/mapbox/static`, which proxies Mapbox Static Images server-side so the
# token never reaches the client. Leave empty to show the "Map preview
# unavailable" fallback. A real key belongs only in the ignored .env/.dev.vars
# locally, or as a `wrangler secret put MAPBOX_API_KEY` secret in production.
MAPBOX_API_KEY=
# Location search still geocodes through OpenStreetMap Nominatim (cached ~1h, 1 req/sec).
# Card pipeline: v2 enables the present_card tool; off keeps client-only inference.
CARDS_MODE=v2
