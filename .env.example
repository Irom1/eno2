# Copy to .env (local Vite dev) and/or .dev.vars (wrangler dev) and fill in real values.
# Never commit real credentials.
NESSIE_API_KEY=private
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
GEMINI_API_KEY=private
GEMINI_MODEL=gemini-3.8-flash
LLM=gemini
# Server secret/var (never exposed to the client). Required for ATM map previews;
# without it the ATM card shows a "Map preview unavailable" fallback.
MAPBOX_TOKEN=
# Card pipeline: v2 enables the present_card tool; off keeps client-only inference.
CARDS_MODE=v2
