{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eno2",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  // Server-only secrets are set with `wrangler secret put` (never commit values):
  // NESSIE_API_KEY, GEMINI_API_KEY and MAPBOX_API_KEY. MAPBOX_API_KEY holds the
  // Mapbox public token used only by the `/api/mapbox/static` proxy, so it is a
  // private secret and never a `vars` value. Location search geocodes through
  // OpenStreetMap Nominatim.
  "vars": {
    "ALLOW_SEED": "0",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "LLM": "gemini",
    "CARDS_MODE": "v2",
    "NESSIE_BASE_URL": "https://prod-api.nessieisreal.com"
  }
}
