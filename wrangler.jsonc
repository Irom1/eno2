{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eno2",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  // Server-only secrets are set with `wrangler secret put` (never commit values):
  // NESSIE_API_KEY, GEMINI_API_KEY, ELEVENLABS_API_KEY and MAPBOX_API_KEY. The
  // read-aloud proxy reads only ELEVENLABS_API_KEY from the environment; the
  // voice (Adam) and model (eleven_turbo_v2_5) are hardcoded in `/api/tts`.
  // MAPBOX_API_KEY holds the
  // Mapbox public token used only by the `/api/mapbox/static` proxy, so it is a
  // private secret and never a `vars` value. Location search geocodes through
  // OpenStreetMap Nominatim.
  //
  // MAPBOX_REFERER is a deploy-time setting (a plain `vars` value is fine; it is
  // not sensitive) for the same proxy. Mapbox tokens with URL restrictions only
  // accept requests whose Referer is on the token's allowlist, so set it to the
  // deployed origin (for example `https://eno2.example.workers.dev/`) and add
  // that origin to the Mapbox token's URL restrictions. When unset the proxy
  // falls back to `http://localhost:5184/` for local development.
  "vars": {
    "ALLOW_SEED": "0",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "LLM": "gemini",
    "CARDS_MODE": "v2",
    "NESSIE_BASE_URL": "https://prod-api.nessieisreal.com"
  }
}
