{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eno2",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  // Server-only secrets are set with `wrangler secret put` (never commit values):
  // NESSIE_API_KEY and GEMINI_API_KEY. ATM map previews use the keyless
  // OpenStreetMap embed, and location search geocodes through Nominatim.
  "vars": {
    "ALLOW_SEED": "0",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "LLM": "gemini",
    "CARDS_MODE": "v2",
    "NESSIE_BASE_URL": "https://prod-api.nessieisreal.com"
  }
}
